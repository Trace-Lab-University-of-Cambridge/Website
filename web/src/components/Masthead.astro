---
/*
  THESIS: The opening is the lab's remit drawn as a systematic index — four
  research verticals that construct themselves on load — not a hero banner with
  a stock photo. It refuses the centered-headline-over-image default.
  OWN-WORLD: Umang's navy field, Archivo + IBM Plex Mono, orange as the single
  signal. Hairline rules on navy; labels in the machine face; one accent tick.
  STORY: A visitor sees, in seconds, that this is a serious Cambridge lab with
  four clear programmes — and can step straight into any of them.
  FIRST VIEWPORT: full navy stage; left = eyebrow + thesis + sub; right = four
  numbered lanes whose rules draw left-to-right, 01→04, labels arriving after.
  FORM: an index/spec sheet that animates its own construction.
*/
const verticals = [
  { n: '01', label: 'Societal Impacts', meta: 'Externalis', url: 'https://externalis.ai' },
  { n: '02', label: 'Agent Orchestration', meta: 'Tailor', url: 'https://tailorworkflow.com/' },
  { n: '03', label: 'Deployment', meta: 'Deployment of AI', url: 'https://deploymentof.ai' },
  { n: '04', label: 'Lab Research', meta: 'Fundamentals & evaluation', url: '/#research' },
];
---
<section class="stage">
  <div class="wrap stage__grid">
    <div class="stage__copy">
      <p class="eyebrow eyebrow--light stage__eyebrow"><b>TR</b>ustworthy <b>A</b>rtificial intelligen<b>CE</b> Laboratory</p>
      <h1 class="stage__thesis">Trustworthy AI @ University of Cambridge</h1>
      <p class="stage__sub">
        We study how AI systems behave once people and institutions depend on them — across four
        programmes, from second-order effects to deployment in real organisations.
      </p>
      <p class="stage__affil">University of Cambridge &nbsp;·&nbsp; Centre for Human-Inspired AI &nbsp;·&nbsp; King's College</p>
    </div>

    <div class="stage__index" role="list" aria-label="Research programmes">
      {verticals.map((v, i) => (
        <a class="lane" href={v.url} role="listitem" rel={v.url.startsWith('http') ? 'noopener' : undefined} style={`--i:${i}`}>
          <span class="lane__rule"><span class="lane__fill"></span></span>
          <span class="lane__row">
            <span class="lane__num code">{v.n}</span>
            <span class="lane__label">{v.label}</span>
            <span class="lane__meta code">{v.meta}</span>
          </span>
        </a>
      ))}
    </div>
  </div>

  <a class="stage__scroll" href="#research" aria-label="Scroll to research">
    <span class="stage__scroll-label code">Scroll</span>
    <span class="stage__scroll-line"></span>
  </a>
</section>

<style>
  .stage {
    position: relative;
    background: var(--navy-deep);
    color: #fff;
    min-height: calc(100svh - 62px);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 72px 0 96px;
  }
  /* Faint scattered TRACE "A" texture, same device as the band pattern but low. */
  .stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/media/trace-pattern-light.svg') repeat;
    background-size: 560px 448px;
    opacity: 0.05;
    pointer-events: none;
  }

  .stage__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 64px;
    align-items: center;
    width: 100%;
  }

  .stage__eyebrow { animation: fade-up 0.7s var(--ease-out, cubic-bezier(.16,1,.3,1)) both; }
  .stage__thesis {
    margin: 20px 0 0;
    font-size: clamp(34px, 4.6vw, 60px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    max-width: 15ch;
    animation: fade-up 0.8s cubic-bezier(.16,1,.3,1) 0.06s both;
  }
  .stage__sub {
    margin: 22px 0 0;
    max-width: 46ch;
    font-size: var(--fs-lg);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.78);
    animation: fade-up 0.8s cubic-bezier(.16,1,.3,1) 0.14s both;
  }
  .stage__affil {
    margin: 34px 0 0;
    font-family: var(--mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.5);
    animation: fade-up 0.8s cubic-bezier(.16,1,.3,1) 0.22s both;
  }

  /* The four verticals as a self-constructing index. */
  .stage__index { display: flex; flex-direction: column; }
  .lane {
    position: relative;
    display: block;
    padding: 22px 4px 18px;
    color: #fff;
    text-decoration: none;
  }
  .lane:last-child { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  /* Static top hairline drawn instantly; the orange fill draws over it. */
  .lane__rule {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }
  .lane__fill {
    position: absolute;
    inset: 0;
    background: var(--orange);
    transform: scaleX(0);
    transform-origin: left;
    animation: draw 0.7s cubic-bezier(.16,1,.3,1) calc(0.3s + var(--i) * 0.13s) both;
  }
  .lane__row {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: baseline;
    gap: 18px;
    animation: fade-up 0.6s cubic-bezier(.16,1,.3,1) calc(0.42s + var(--i) * 0.13s) both;
  }
  .lane__num { color: var(--orange); }
  .lane__label {
    font-size: clamp(20px, 2.2vw, 30px);
    font-weight: 600;
    letter-spacing: -0.02em;
    transition: color 0.18s ease, transform 0.18s ease;
  }
  .lane__meta { color: rgba(255, 255, 255, 0.5); }
  .lane:hover .lane__label { color: var(--orange); transform: translateX(4px); }
  .lane:hover .lane__meta { color: rgba(255, 255, 255, 0.8); }
  .lane:focus-visible { outline: 2px solid var(--orange); outline-offset: 4px; border-radius: 2px; }

  .stage__scroll {
    position: absolute;
    left: 50%;
    bottom: 26px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.55);
    animation: fade-up 0.8s ease 1s both;
  }
  .stage__scroll:hover { color: #fff; }
  .stage__scroll-label { letter-spacing: 0.12em; text-transform: uppercase; }
  .stage__scroll-line { width: 1px; height: 30px; background: currentColor; animation: scroll-cue 1.9s ease-in-out infinite; transform-origin: top; }

  @keyframes fade-up { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes draw { to { transform: scaleX(1); } }
  @keyframes scroll-cue { 0%,100% { transform: scaleY(0.4); opacity: 0.5; } 50% { transform: scaleY(1); opacity: 1; } }

  @media (max-width: 900px) {
    .stage { min-height: 0; padding: 56px 0 72px; }
    .stage__grid { grid-template-columns: 1fr; gap: 44px; }
    .stage__scroll { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage__eyebrow, .stage__thesis, .stage__sub, .stage__affil,
    .lane__row, .stage__scroll { animation: none; opacity: 1; transform: none; }
    .lane__fill { animation: none; transform: scaleX(1); }
    .stage__scroll-line { animation: none; }
  }
</style>
