---
import Base from '../layouts/Base.astro';
import Publications from '../components/Publications.tsx';
import publications from '../data/publications.yaml';
const count = ((publications as any).publications ?? []).length;
---
<Base title="Publications · TRACE Lab" description="Papers from the TRACE Lab at the University of Cambridge.">
  <header class="pagehead">
    <div class="wrap rail">
      <div aria-hidden="true"></div>
      <div class="rail__body">
        <p class="eyebrow">TRACE Lab</p>
        <h1 class="pagehead__title">Publications</h1>
        <p class="pagehead__sub">
          {count} papers. Also on
          <a href="https://scholar.google.com/citations?user=qq8bxPkAAAAJ&hl=en" rel="noopener">Google Scholar</a>.
        </p>
      </div>
    </div>
  </header>

  <section class="band">
    <div class="wrap rail">
      <h2 class="rail__label">Papers</h2>
      <div class="rail__body">
        <!-- Interactive island: timeline + filter + rows. Rest of page is static. -->
        <Publications client:load />
      </div>
    </div>
  </section>
</Base>
